{
  "name": "zafu-pchospital-web",
  "version": "0.1.0",
  "private": true,
  "description": "浙江农林大学电脑医院 · 社团综合服务平台官网",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node tools/ensure-doc-manifest.mjs",
    "predev": "node tools/ensure-doc-manifest.mjs",
    "dev": "next dev",
    "build": "pnpm docs:build && next build",
    "prebuild:site": "node tools/ensure-doc-manifest.mjs",
    "build:site": "next build",
    "docs:build": "node tools/build-docs.mjs",
    "start": "next start",
    "lint": "eslint . && node tools/check-theme-palette.mjs",
    "check:palette": "node tools/check-theme-palette.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  }
}
